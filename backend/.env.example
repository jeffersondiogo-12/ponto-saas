# --- Banco de dados ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ponto
DB_PASSWORD=troque_essa_senha
DB_NAME=ponto_saas
DB_SSL=false
# Em producao, prefira true com a CA oficial do provedor.
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA=

# --- Aplicacao ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Autenticacao ---
# Gere uma chave forte: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=8h
SESSION_SECRET=

# --- Criptografia de credenciais de dispositivos ---
# As senhas dos relogios de ponto sao guardadas cifradas com esta chave (AES-256-GCM).
# Gere com: openssl rand -hex 32
DEVICE_CREDENTIALS_KEY=

# --- Coleta automatica dos relogios (dispositivos modo_conexao=client, ex: zk_tcp) ---
# Intervalo, em minutos, entre coletas automaticas de cada dispositivo ativo.
COLETA_INTERVALO_MINUTOS=5

# --- Servidor WebSocket do Evo Facial (dispositivos modo_conexao=server, protocolo evo_ws) ---
# O WebSocket compartilha a MESMA porta HTTP da API (PORT, acima) - nao existe
# porta separada (Render e a maioria dos PaaS so expoem uma porta publica por
# servico). Configure no equipamento o mesmo host/porta que a API usa (ver
# README secao 6 e o PDF do protocolo do fabricante).
# true loga o JSON cru trocado com o equipamento nos dois sentidos - ligue
# temporariamente ao testar com hardware real pela primeira vez.
EVO_FACIAL_DEBUG=false
