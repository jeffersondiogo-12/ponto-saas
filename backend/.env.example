# --- Banco de dados ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ponto
DB_PASSWORD=troque_essa_senha
DB_NAME=ponto_saas
DB_SSL=false

# --- Aplicacao ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Autenticacao ---
# Gere uma chave forte: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=8h
SESSION_SECRET=

# --- Criptografia de credenciais de dispositivos ---
# As senhas dos relogios de ponto sao guardadas cifradas com esta chave (AES-256-GCM).
# Gere com: openssl rand -hex 32
DEVICE_CREDENTIALS_KEY=

# --- Coleta automatica dos relogios (dispositivos modo_conexao=client, ex: zk_tcp) ---
# Intervalo, em minutos, entre coletas automaticas de cada dispositivo ativo.
COLETA_INTERVALO_MINUTOS=5

# --- Servidor WebSocket do Evo Facial (dispositivos modo_conexao=server, protocolo evo_ws) ---
# Porta em que este backend ESCUTA por conexoes vindas do(s) equipamento(s) -
# configure a MESMA porta no menu do equipamento, apontando para o IP deste
# servidor (ver README secao 6 e o PDF do protocolo do fabricante).
EVO_FACIAL_WS_PORT=9998
