{
  "name": "ponto-saas-backend",
  "version": "0.2.0",
  "description": "API pura do sistema de controle de ponto (REP-P / Portaria 671), consumida pelo site (web/) e pelo app (mobile/)",
  "main": "src/server.js",
  "scripts": {
    "prestart": "npm run build --prefix ../web",
    "start": "knex migrate:latest && node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "coleta:worker": "node src/jobs/coletaScheduler.js",
    "simular:evo-facial": "node scripts/simular-evo-facial.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "node-zklib": "^1.3.0",
    "pg": "^8.12.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
